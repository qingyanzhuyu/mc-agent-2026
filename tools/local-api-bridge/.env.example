# HTTP 桥接监听地址：
# - 127.0.0.1：仅本机访问（默认，队友各自在本机 npm start 即可直连队内公网穿透测试服）
# - 0.0.0.0：对局域网开放 HTTP 端口
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# 队内共享 Minecraft Java 1.21.11 原版测试服（online-mode=false）
# 默认已指向队内穿透地址 frp-net.com:64463；若连自己本机服可改为 127.0.0.1:25565
MC_HOST=frp-net.com
MC_PORT=64463
MC_VERSION=1.21.11

# 会话与重连节流参数（对齐 api-spec-v1.3.1 §1.1 / §2.1）
TOKEN_TTL_MS=86400000
RECONNECT_INTERVAL_MS=30000
