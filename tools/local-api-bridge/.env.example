# HTTP 桥接监听地址：
# - 127.0.0.1：仅本机访问（默认，适合本机单人联调）
# - 0.0.0.0：对局域网队友开放，队友无需安装 Node.js，直接将 MC_API_BASE 指向 http://<本机局域网IP>:8787/api/v1
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# 目标 Minecraft Java 1.21.11 原版测试服地址（server.properties 须设 online-mode=false）
# 若连接队友搭建的局域网测试服，请改为对应局域网 IP（例如 10.x.x.x 或 192.168.x.x）
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.21.11

# 会话与重连节流参数（对齐 api-spec-v1.3.1 §1.1 / §2.1）
TOKEN_TTL_MS=86400000
RECONNECT_INTERVAL_MS=30000
