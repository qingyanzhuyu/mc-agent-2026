# MC_API_BASE=https://mc-api.windywindie.top/api/v1
MC_API_BASE=https://mc-api.windywindie.top/api/v1

# 皮肤站账号（https://skin.nmo.net.cn/ 注册，里面要先选定角色，否则登录报 no_profile）
MC_USER=
MC_PASS=

# 代理：留空 = 直连（推荐）。
# 实测：mc-api 直连 666ms / 走 7897 是 642ms，没差别 -> 直连，少一个故障点。
# 如果比赛当天直连抽风，再填 http://127.0.0.1:7897
MC_PROXY=

# ---- LLM 端点（当前代码里还没有消费者，等 planner 的实现进仓库再启用）----
# 实测 api.nju-aia.com：直连 1520ms / 走 7897 是 219ms -> 这个端点必须走代理
# 模型 id 先写 default：群里给的字面 id qwen3.6-35b-a3b 在当前 key 上是 403
#LLM_BASE=https://api.nju-aia.com/v1
#LLM_KEY=
#LLM_MODEL=default
#LLM_PROXY=http://127.0.0.1:7897
