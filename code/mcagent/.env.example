# 正式赛官方端点（二选一，按所在网络决定）：
#   校园网直连：仅校内可访问，实测 p50 ≈ 5 ms      [2026-11-14 官方新增]
#   公网隧道：  任意网络可访问，实测 p50 ≈ 1305 ms  [Cloudflare Tunnel，延迟高是它的锅]
# 比赛当天用哪个尚未公布（docs/04 B13）；不确定时先用校园网，不通再换公网。
#MC_API_BASE=https://apiin.nmo.net.cn/api/v1
MC_API_BASE=https://mc-api.windywindie.top/api/v1
# 本地/局域网模拟靶场联调（启动方法见 ../../tools/local-api-bridge/README.md）：
#MC_API_BASE=http://127.0.0.1:8787/api/v1

# 皮肤站账号（https://skin.nmo.net.cn/ 注册，里面要先选定角色，否则登录报 no_profile）
MC_USER=
MC_PASS=

# Token 落盘缓存路径（默认存在 mcagent/.token.json，重启进程直接复用，避免重登互踢；设为空串则仅存内存）
#MC_TOKEN_FILE=

# 代理：留空 = 直连（推荐）。
# 实测：mc-api 直连 666ms / 走 7897 是 642ms，没差别 -> 直连，少一个故障点。
# 如果比赛当天直连抽风，再填 http://127.0.0.1:7897
MC_PROXY=

# ---- LLM 端点（planner/llm.py 使用）----
# 实测（2026-11-14）：
#   · model 只能写 default —— 后端实际是 qwen3.6-35b-a3b，但字面写模型名会 403
#   · 单流约 25 tok/s（端到端），投机解码接受率 84–96%，上下文上限 256K
#   · 长请求走代理会被掐断，所以 llm.py 分两条路径：快路径代理、慢路径直连
#
# 🔴 并发：**比赛期每组只能 2 路**（官方 11-14 23:00，可能降至 1 路）。
#    开发/压测期官方给到 48 路。代码默认值必须按比赛写 2，压测时再临时调大。
#    ⚠️ 赛前务必确认这个值被改回 2 —— 这是最容易忘、后果最重的一项。
#
# 两套模型配置，用 LLM_PROFILE 二选一（一次进程只用一套，不会自动互切）：
#   official（默认，不写也是它）：官方 AIA 统一代理，**比赛唯一合法配置**
#   custom：自备 key 的 OpenAI 兼容端点，**只给赛前测试**；preflight 会 BLOCK，
#           mcagent.loop 在 MC 指向官方端点时也会拒绝启动（AGENTS.md §2B.3）
#   临时切换不必改文件：LLM_PROFILE=custom uv run python -m mcagent.loop ...
#LLM_PROFILE=official
#
# ---- official ----
#LLM_BASE=https://api.nju-aia.com/v1
#LLM_KEY=
#LLM_MODEL=default
#LLM_MAX_CONCURRENCY=2
#LLM_PROXY_FAST=http://127.0.0.1:7897
#
# ---- custom（三项都必填，没有缺省值）----
# 端点若不认 chat_template_kwargs（关思考字段）回 400，会自动去掉重发一次，之后本进程不再带。
# 换了模型后：选技能的合法率/回落率、token 数都不能代表比赛模型，测试数据要注明 llm_model。
#LLM_CUSTOM_BASE=https://api.deepseek.com/v1
#LLM_CUSTOM_KEY=
#LLM_CUSTOM_MODEL=deepseek-chat
# 留空 = 直连；需要走本机代理再填
#LLM_CUSTOM_PROXY=
# LLM_MAX_CONCURRENCY 与 LLM_BREAKER_* 两套共用
# 降级（工程默认值，未经真机标定）：代理连不上或回 502/503/504 时，同一次调用里改直连重试；
# 连续失败 LLM_BREAKER_FAILS 次后熔断 LLM_BREAKER_COOLDOWN_S 秒（代理线路与端点整体各算各的）。
# 直连仍是同一个官方端点，不是第二个模型服务。LLM_FALLBACK_DIRECT=0 可关掉降级直连。
#LLM_FALLBACK_DIRECT=1
#LLM_BREAKER_FAILS=3
#LLM_BREAKER_COOLDOWN_S=60

# ---- 四层调度（临时工程默认值，官方 C1/寻路实测后标定）----
# Config.load() 先加载 .env，再构建 State / Safety / DecisionScheduler。
MC_MAX_RPS=4
MC_POLL_SAFE_S=4
MC_POLL_RISK_S=1
MC_STATUS_TTL_S=1
MC_STOP_COOLDOWN_S=10
MC_HP_CRIT=8
MC_HP_RISK=14
MC_OXYGEN_WARN=80
MC_HOSTILE_RISK_DIST=16
MC_HOSTILE_FLEE_DIST=6
MC_NIGHT_START=13000
MC_NIGHT_END=23000
MC_SUPPORT_TTL_S=5
MC_VOID_FALL_DELTA=0.5
# 死亡循环保护只可上调，不得低于 65 秒。
MC_SAFE_COOLDOWN_S=65
MC_MODEL_TIMEOUT_S=8
MC_MODEL_MIN_INTERVAL_S=20
MC_MODEL_REVIEW_S=240
MC_MODEL_FAILURE_COUNT=2
