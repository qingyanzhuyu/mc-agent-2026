# 正式赛官方端点：
MC_API_BASE=https://mc-api.windywindie.top/api/v1
# 本地/局域网模拟靶场联调（启动方法见 ../../tools/local-api-bridge/README.md）：
#MC_API_BASE=http://127.0.0.1:8787/api/v1

# 皮肤站账号（https://skin.nmo.net.cn/ 注册，里面要先选定角色，否则登录报 no_profile）
MC_USER=
MC_PASS=

# Token 落盘缓存路径（默认存在 mcagent/.token.json，重启进程直接复用，避免重登互踢；设为空串则仅存内存）
#MC_TOKEN_FILE=

# 代理：留空 = 直连（推荐）。
# 实测：mc-api 直连 666ms / 走 7897 是 642ms，没差别 -> 直连，少一个故障点。
# 如果比赛当天直连抽风，再填 http://127.0.0.1:7897
MC_PROXY=

# ---- LLM 端点（planner/llm.py 使用）----
# 实测（2026-11-13）：
#   · model 只能写 default —— 后端实际是 qwen3.6-35b-a3b，但字面写模型名会 403
#   · 关思考 356ms、开思考 3.2s；长请求走代理会被掐断，所以分两条路径
# 快路径走代理、慢路径直连，这个分路写在 llm.py 里，不用手改
#LLM_BASE=https://api.nju-aia.com/v1
#LLM_KEY=
#LLM_MODEL=default
#LLM_PROXY_FAST=http://127.0.0.1:7897
