# 比赛配置模板：复制成 code/mcagent/.env.match 后填真实值
# 用法：
#   cp .env.match.example .env.match      # 填下表 5 个值
#   python -m mcagent.preflight --apply   # 一条命令切换 + 自检
#   python -m mcagent.preflight           # 只检查，不切换
# 赛前清单一律见 plan/赛前切换清单.md

# ---- 1. MC Agent 端点（比赛期二选一）----
# 校园网直连（推荐，实测 5ms）：仅校内可访问
MC_API_BASE=https://apiin.nmo.net.cn/api/v1
# 公网隧道（备用，实测约 500-1300ms）：任何网络可访问
#MC_API_BASE=https://mc-api.windywindie.top/api/v1

# ---- 2. 皮肤站账号（必须是正式角色）----
MC_USER=
MC_PASS=

# 校园网直连时留空；走公网且需要代理时才填
MC_PROXY=

# ---- 3. 推理端点 ----
LLM_BASE=https://api.nju-aia.com/v1
LLM_KEY=
# 只能写 default，写模型名会被 403
LLM_MODEL=default
# 比赛期每组 2 路（官方 2026-11-14 口径）；开发/压测期可临时调大，赛前必须改回
LLM_MAX_CONCURRENCY=2
LLM_PROXY_FAST=http://127.0.0.1:7897
